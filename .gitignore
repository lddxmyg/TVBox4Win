# ============================================================
#  TVBox4Win（tvboxpy）本地仓库忽略规则
# ============================================================

# ---------- 构建产物 ----------
build/
dist/
.venv/
**/__pycache__/
*.py[cod]
*.spec.bak

# ---------- 第三方二进制（libmpv 等不入库，下载方式见 tvboxpy/README.md）----------
*.dll
*.so
*.so.*
*.a
*.lib
*.dylib
*.exe
*.apk
*.jar
*.7z
*.zip

# ---------- 运行期缓存 / 状态 / 用户配置 ----------
.imgcache/
.jar_cache/
.spider_cache/
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
hawk.json

# ---------- 参考工程（reference/）中的二进制资产 ----------
reference/app/libs/

# ---------- 智能体工作目录 / 系统 ----------
.workbuddy/
.gradle/
tvbox4win_preview.png
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp

# ---------- 自检产物 ----------
check_result.txt
smoke_result.txt

# ---------- Android（Kivy / python-for-android）----------
android/.buildozer/
android/vendor/
android/bin/
android/build/
android/*.png

# ---------- 原生安卓工程（tvbox-native）----------
tvbox-native/app/build/
tvbox-native/.gradle/
tvbox-native/.kotlin/
tvbox-native/local.properties
tvbox-native/build_log.txt
tvbox-native/*.apk
!tvbox-native/app/libs/*.jar
!tvbox-native/app/libs/*.aar
!tvbox-native/gradle/wrapper/gradle-wrapper.jar
!android/gradle/wrapper/gradle-wrapper.jar

# ---------- 本地参考克隆（不入库）----------
fongmi-tv/
pyramid-src/
